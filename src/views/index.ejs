<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= etiqueta %></title>
    <%- include('partials/head.ejs') %>
  </head>
  <body>
    <%- include('partials/navigation.ejs') %>

    <!-- Carrusel -->
    <div id="carouselExampleControls" class="carousel slide" data-bs-ride="carousel">
      <div class="carousel-inner">
        <div class="carousel-item active">
          <img src="/img/slider2.png" class="d-block w-100" alt="primer slide" style="height: 360px; object-fit: cover;"> />
        </div>
        <div class="carousel-item">
          <img src="/img/slider3.jpg" class="d-block w-100" alt="Segundo slide"  style="height: 350px; object-fit: cover;">/>
        </div>
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleControls" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
      </button>
    </div>

    <!-- Contenido -->
    <div class="container-fluid">
      <div class="row py-5">
        <div class="col-md-6">
          <div class="card flex-md-row mb-4 shadow-sm">
            <div class="card-body d-flex flex-column align-items-start">
              <strong class="d-inline-block mb-2 text-primary">Tecnología</strong>
              <h3 class="mb-0">
                <a class="text-dark" href="#">Desarrollo de Software</a>
              </h3>
              <div class="mb-1 text-muted">Agosto 28</div>
              <p class="card-text mb-auto">
                Lorem ipsum dolor sit amet consectetur adipisicing elit. Nostrum deleniti aspernatur deserunt non debitis quod dolore.
              </p>
            </div>
            <img class="card-img-right flex-auto d-none d-md-block" src="/img/images2.png" alt="Imagen" />
          </div>
        </div>

        <div class="col-md-6">
          <div class="card flex-md-row mb-4 shadow-sm">
            <div class="card-body d-flex flex-column align-items-start">
              <strong class="d-inline-block mb-2 text-success">Software Empresariales</strong>
              <h3 class="mb-0">
                <a class="text-dark" href="#">Soluciones de Software</a>
              </h3>
              <div class="mb-1 text-muted">Agosto 28</div>
              <p class="card-text mb-auto">
                Lorem ipsum dolor sit amet, consectetur adipisicing elit. Magni repellat harum vitae.
              </p>
            </div>
            <img class="card-img-right flex-auto d-none d-md-block" src="/img/images1.png" alt="Imagen" />
          </div>
        </div>
      </div>
    </div>

    <%- include('partials/scripts.ejs') %>
    <%- include('partials/footers.ejs') %>
  </body>
</html>
